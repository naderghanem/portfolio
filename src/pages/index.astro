---
import Base from "../layouts/Base.astro";
import AskButton from "../components/AskButton.astro";
import { getCollection, render } from "astro:content";
import * as simpleIcons from "simple-icons";
import {
  profile,
  stack,
  roles,
  credentials,
  education,
  languages,
} from "../data/site";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = await Promise.all(
  entries.map(async (entry) => ({
    ...entry.data,
    Content: (await render(entry)).Content,
  }))
);

// Career axis geometry. Span runs 2016 -> now; x is linear in years.
const AXIS = { x0: 10, x1: 990, from: 2016, to: 2026.75 };
const x = (year: number) =>
  AXIS.x0 + ((year - AXIS.from) / (AXIS.to - AXIS.from)) * (AXIS.x1 - AXIS.x0);
const pct = (year: number) => (x(year) / 1000) * 100;

const majorTicks = [
  { year: 2016, label: "2016", align: "start" },
  { year: 2019, label: "2019", align: "mid" },
  { year: 2021, label: "2021", align: "mid" },
  { year: 2023.67, label: "2023", align: "mid" },
  { year: AXIS.to, label: "now", align: "end" },
];
const minorTicks = [2017, 2018, 2020, 2022, 2024, 2025];

// Each role is a segment on the line, so the axis shows the shape of the
// career rather than decorating the hero.
const segments = roles.map((role) => ({
  label: `${role.company}, ${role.period}`,
  x1: x(role.from),
  x2: x(role.to),
  current: role.end === null,
}));

// Labels are HTML, not SVG <text>: SVG text scales with the viewBox and would
// shrink to a few pixels on a phone.
const shift = { start: "none", mid: "translateX(-50%)", end: "translateX(-100%)" };

// CV download. Name and size are measured from the real file in
// astro.config.mjs and inlined here, so the label cannot go stale when the
// CV is replaced, and nothing touches the filesystem at render time.
const cv = {
  href: `/${__CV_FILE__}`,
  format: "PDF",
  size: `${__CV_SIZE_KB__} KB`,
};

// Binary waterfall beside the headline. Generated once at build time from a
// fixed seed, so the markup is byte-identical between builds instead of
// churning the diff, and the browser ships no generator script.
const RAIN_COLUMNS = 28;
const RAIN_GLYPHS = 34;

// mulberry32 — a plain LCG here leaves a visible 0101 stripe down the columns.
const seeded = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) >>> 0;
  let t = seed;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const random = seeded(20260904);

const rain = Array.from({ length: RAIN_COLUMNS }, () => {
  const digits = Array.from({ length: RAIN_GLYPHS }, () =>
    random() < 0.5 ? "0" : "1"
  ).join("\n");
  return {
    // Doubled: half a column is exactly one period, so the fall loops seamlessly.
    stream: `${digits}\n${digits}`,
    duration: (7 + random() * 11).toFixed(2),
    // Negative delay, so every column is already mid-fall on first paint.
    delay: (-random() * 20).toFixed(2),
    lit: random() < 0.3,
  };
});

type SimpleIcon = { slug: string; path: string };

const iconPaths = new Map<string, string>();
for (const icon of Object.values(simpleIcons) as SimpleIcon[]) {
  if (icon?.slug) iconPaths.set(icon.slug, icon.path);
}

// Each tile resolved to a path or a lettered mark up front, so the template
// carries no branching of its own beyond picking one of the two.
const tiles = stack.map((row) => ({
  layer: row.layer,
  items: row.items.map((item) => ({
    name: item.name,
    path: item.icon ? iconPaths.get(item.icon) : undefined,
    mark: item.mark ?? item.name.slice(0, 2),
  })),
}));

const currentYear = new Date().getFullYear();
---

<Base
  title={`${profile.name} — ${profile.role}`}
  description="Backend engineer in the Netherlands working in PHP and Symfony on SaaS and logistics platforms. PSM II certified Scrum Master."
>
  <div class="shell">
    <header class="masthead">
      <span class="masthead__name">{profile.name}</span>
      <div class="masthead__end">
        <nav class="masthead__nav" aria-label="Sections">
          <a href="#skills">Skills</a>
          <a href="#experience">Experience</a>
          <a href="#notes">Case notes</a>
          <a href="#contact">Contact</a>
        </nav>
        <button
          class="crt-btn"
          type="button"
          data-theme-toggle
          aria-label="Switch colour theme"
        >
          <span class="crt-btn__face crt-btn__face--light">
            <svg
              class="crt-btn__icon"
              viewBox="0 0 9 9"
              shape-rendering="crispEdges"
              fill="currentColor"
              aria-hidden="true"
            >
              <rect x="3" y="3" width="3" height="3" />
              <rect x="4" y="0" width="1" height="1" />
              <rect x="4" y="8" width="1" height="1" />
              <rect x="0" y="4" width="1" height="1" />
              <rect x="8" y="4" width="1" height="1" />
              <rect x="1" y="1" width="1" height="1" />
              <rect x="7" y="1" width="1" height="1" />
              <rect x="1" y="7" width="1" height="1" />
              <rect x="7" y="7" width="1" height="1" />
            </svg>
            LIGHT
          </span>
          <span class="crt-btn__face crt-btn__face--dark">
            <svg
              class="crt-btn__icon"
              viewBox="0 0 9 9"
              shape-rendering="crispEdges"
              fill="currentColor"
              aria-hidden="true"
            >
              <rect x="3" y="1" width="3" height="1" />
              <rect x="2" y="2" width="3" height="1" />
              <rect x="1" y="3" width="3" height="1" />
              <rect x="1" y="4" width="3" height="1" />
              <rect x="1" y="5" width="3" height="1" />
              <rect x="2" y="6" width="3" height="1" />
              <rect x="3" y="7" width="3" height="1" />
            </svg>
            DARK
          </span>
        </button>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="hero__stage">
          <div class="rain" aria-hidden="true">
            <div class="rain__cols">
              {rain.map((col) => (
                <span
                  class:list={["rain__col", { "rain__col--lit": col.lit }]}
                  style={`animation-duration:${col.duration}s;animation-delay:${col.delay}s`}
                >{col.stream}</span>
              ))}
            </div>
          </div>

          <div class="hero__text">
            <p class="hero__role">{profile.role} | {profile.location}</p>
            <h1 class="hero__statement">{profile.statement}</h1>
          </div>
        </div>

        <div class="axis" role="img" aria-label="Career timeline running from 2016 to the present, with the current role beginning in 2023.">
          <svg class="axis__svg" viewBox="0 0 1000 60" preserveAspectRatio="none" aria-hidden="true">
            <line class="axis__rule" x1={AXIS.x0} y1="30" x2={AXIS.x1} y2="30" />
            {minorTicks.map((y) => (
              <line class="axis__tick" x1={x(y)} y1="26" x2={x(y)} y2="34" />
            ))}
            {majorTicks.map((t) => (
              <line class="axis__tick" x1={x(t.year)} y1="20" x2={x(t.year)} y2="40" />
            ))}
            {segments.map((seg) => (
              <line
                class:list={["axis__seg", { "axis__seg--current": seg.current }]}
                x1={seg.x1}
                y1="30"
                x2={seg.x2}
                y2="30"
              >
                <title>{seg.label}</title>
              </line>
            ))}
          </svg>
          <div class="axis__labels" aria-hidden="true">
            {majorTicks.map((t) => (
              <span
                class:list={[
                  "axis__label",
                  { "axis__label--mid": t.align === "mid" },
                  { "axis__label--now": t.label === "now" },
                ]}
                style={`left:${pct(t.year)}%;transform:${shift[t.align as keyof typeof shift]}`}
              >
                {t.label}
              </span>
            ))}
          </div>
          <div class="axis__caption">
            <AskButton />
          </div>
        </div>
      </section>

      <section class="band" id="about">
        <div class="band__grid">
          <h2 class="band__label">About</h2>
          <div>
            {profile.intro.map((para) => <p>{para}</p>)}
          </div>
        </div>
      </section>

      <section class="band" id="skills">
        <div class="band__grid">
          <h2 class="band__label">Skills</h2>
          <div class="stack">
            {tiles.map((row) => (
              <div class="stack__group">
                <h3 class="stack__layer">{row.layer}</h3>
                <ul class="stack__tiles">
                  {row.items.map((item) => (
                    <li class="stack__tile">
                      {item.path ? (
                        <svg
                          class="stack__mark"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d={item.path} />
                        </svg>
                      ) : (
                        <span class="stack__mark stack__mark--letters" aria-hidden="true">{item.mark}</span>
                      )}
                      <span class="stack__name">{item.name}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="band" id="experience">
        <div class="band__grid">
          <h2 class="band__label">Experience</h2>
          <div class="work">
            {roles.map((role) => (
              <article class:list={["role", { "role--current": role.end === null }]}>
                <div class="role__head">
                  <h3 class="role__company">{role.company}</h3>
                  <span class="role__period">{role.period}</span>
                </div>
                <p class="role__title">{role.title}, {role.place}</p>
                <p class="role__summary">{role.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="band" id="notes">
        <div class="band__grid">
          <h2 class="band__label">Case notes</h2>
          <div class="notes">
            {projects.map((project) => (
              <article class="note">
                <div>
                  <h3 class="note__title">{project.title}</h3>
                  <p class="note__context">{project.context}</p>
                  <div class="note__tags">
                    {project.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                </div>
                <div class="note__body">
                  <project.Content />
                  {project.demo && <AskButton class="note__demo" />}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="band" id="credentials">
        <div class="band__grid">
          <h2 class="band__label">Certification</h2>
          <div>
            {credentials.map((cred) => (
              <div class="cred">
                <h3 class="cred__title">{cred.title}</h3>
                <p class="cred__issuer">{cred.issuer}</p>
                <p class="cred__note">{cred.note}</p>
                {cred.url && (
                  <a class="cred__link" href={cred.url} target="_blank" rel="noopener noreferrer">
                    View Badge
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="band" id="education">
        <div class="band__grid">
          <h2 class="band__label">Education</h2>
          <div>
            {education.map((item) => (
              <div class="school">
                <span class="school__title">{item.title}</span>
                <span class="school__period">{item.period}</span>
                <span class="school__where">{item.school}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

    </main>

    <footer class="contact" id="contact">
      <h2 class="contact__lead">Let's talk!</h2>

      <div class="contact__cta">
        <a class="crt-btn crt-btn--lg" href={cv.href} download>
          <svg
            class="crt-btn__icon"
            viewBox="0 0 9 9"
            shape-rendering="crispEdges"
            fill="currentColor"
            aria-hidden="true"
          >
            <rect x="3" y="0" width="3" height="3" />
            <rect x="1" y="3" width="7" height="1" />
            <rect x="2" y="4" width="5" height="1" />
            <rect x="3" y="5" width="3" height="1" />
            <rect x="4" y="6" width="1" height="1" />
            <rect x="0" y="8" width="9" height="1" />
          </svg>
          DOWNLOAD CV
        </a>
        <span class="contact__meta">{cv.format}, {cv.size}</span>
      </div>

      <div class="contact__list">
        <div class="contact__item">
          <span class="contact__key">Email</span>
          <span class="contact__value">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </span>
        </div>
        <div class="contact__item">
          <span class="contact__key">LinkedIn</span>
          <span class="contact__value">
            <a href={profile.linkedin} target="_blank" rel="noopener">linkedin.com/in/naderghanem</a>
          </span>
        </div>
        {profile.github && (
          <div class="contact__item">
            <span class="contact__key">GitHub</span>
            <span class="contact__value">
              <a href={profile.github} target="_blank" rel="noopener">
                {profile.github.replace("https://github.com/", "github.com/")}
              </a>
            </span>
          </div>
        )}
        <div class="contact__item">
          <span class="contact__key">Based in</span>
          <span class="contact__value">
            <a href="https://www.google.com/maps/search/?api=1&query=Apeldoorn%2C+Netherlands" target="_blank" rel="noopener noreferrer">
              {profile.location}
            </a>
          </span>
        </div>
        <div class="contact__item">
          <span class="contact__key">Languages</span>
          <span class="contact__value">{languages.join(", ")}</span>
        </div>
      </div>
    </footer>
      <div class="colophon">
          <span>{'< '}Built with passion by {profile.name}{' />'}</span>
          <span role="img" aria-label="Coding, Coffee, and Gaming">&#128187; ☕ 🎮</span>
          <span>© {currentYear} All rights reserved</span>
      </div>
  </div>

  <dialog class="panel" data-chat-panel aria-labelledby="panel-title">
    <div class="panel__inner">
      <header class="panel__head">
        <p class="panel__title" id="panel-title">Ask about my experience</p>
        <button class="panel__close" type="button" data-chat-close aria-label="Close">
          <svg viewBox="0 0 9 9" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
            <rect x="0" y="0" width="1" height="1" /><rect x="1" y="1" width="1" height="1" />
            <rect x="2" y="2" width="1" height="1" /><rect x="3" y="3" width="3" height="3" />
            <rect x="6" y="6" width="1" height="1" /><rect x="7" y="7" width="1" height="1" />
            <rect x="8" y="8" width="1" height="1" /><rect x="8" y="0" width="1" height="1" />
            <rect x="7" y="1" width="1" height="1" /><rect x="6" y="2" width="1" height="1" />
            <rect x="2" y="6" width="1" height="1" /><rect x="1" y="7" width="1" height="1" />
            <rect x="0" y="8" width="1" height="1" />
          </svg>
        </button>
      </header>

      <ul class="chat__log" data-chat-log></ul>

      <div class="chat__starters" data-chat-starters>
        {[
          "What has he built with Symfony?",
          "Does he have queue and messaging experience?",
          "What did he do at CEVA Logistics?",
          "How do I get in touch?",
        ].map((q) => (
          <button class="chat__starter" type="button" data-starter={q}>{q}</button>
        ))}
      </div>

      <form class="chat__form" data-chat-form>
        <label class="chat__label" for="chat-input">Ask about my experience</label>
        <input
          class="chat__input"
          id="chat-input"
          name="question"
          type="text"
          autocomplete="off"
          maxlength="1000"
          placeholder="Ask a question…"
          data-chat-input
        />
        <button class="crt-btn" type="submit">
          <span class="crt-btn__face">SEND</span>
        </button>
      </form>
    </div>
  </dialog>

  <script>
    import "../scripts/theme-toggle.ts";
    import "../scripts/chat.ts";
  </script>
</Base>
