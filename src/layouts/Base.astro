---
import "../styles/global.css";
import { profile } from "../data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// `site` is set in astro.config.mjs, so this always resolves.
const canonical = new URL(Astro.url.pathname, Astro.site!);
// Scrapers do not resolve relative image paths, so the card image is absolute.
const ogImage = new URL("/og.png", Astro.site!);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <!-- The large card is what LinkedIn, Slack and X render for a 1200x630
         image; "summary" would crop it to a thumbnail. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- The only face on the page, so it is fetched up front rather than
         discovered when the stylesheet finally references it. No CDN request
         follows this one. -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-variable.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />

    <!-- Runs before first paint so the page never flashes the wrong theme.
         Inline and blocking on purpose; deferring it would defeat it. -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem("theme");
          document.documentElement.dataset.theme =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
        } catch (e) {
          /* Private mode with storage blocked: fall through to the CSS
             prefers-color-scheme rules, which cover this on their own. */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
