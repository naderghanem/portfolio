---
/**
 * Opens the chat panel. Appears twice — under the hero timeline, and inside
 * the case note about the thing it opens — so it lives here rather than being
 * copied, SVG and all, into both.
 */
interface Props {
  /** Extra class for placement at the call site. */
  class?: string;
}

const { class: className } = Astro.props;
---

<button class:list={["crt-btn", className]} type="button" data-chat-open>
  <span class="crt-btn__face">
    <svg
      class="crt-btn__icon"
      viewBox="0 0 9 9"
      shape-rendering="crispEdges"
      fill="currentColor"
      aria-hidden="true"
    >
      <rect x="0" y="1" width="9" height="1" />
      <rect x="0" y="5" width="9" height="1" />
      <rect x="0" y="2" width="1" height="3" />
      <rect x="8" y="2" width="1" height="3" />
      <rect x="2" y="6" width="2" height="1" />
      <rect x="2" y="7" width="1" height="1" />
      <rect x="2" y="3" width="1" height="1" />
      <rect x="4" y="3" width="1" height="1" />
      <rect x="6" y="3" width="1" height="1" />
    </svg>
    ASK A QUESTION
  </span>
</button>
